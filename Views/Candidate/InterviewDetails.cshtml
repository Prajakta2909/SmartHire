@model SmartHire.Models.JobApplication

@{
    ViewData["Title"] = "Interview Details";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="mb-2">Interview Details</h2>

                    <p class="text-muted">
                        @Model.Job.Title -
                        @Model.Job.RecruiterProfile.CompanyName
                    </p>

                    <hr />

                    <dl class="row">

                        <dt class="col-md-4">
                            Interview Date
                        </dt>

                        <dd class="col-md-8">
                            @Model.Interview!.ScheduledDateTime
                            .ToString("dd MMM yyyy")
                        </dd>

                        <dt class="col-md-4">
                            Interview Time
                        </dt>

                        <dd class="col-md-8">
                            @Model.Interview.ScheduledDateTime
                            .ToString("hh:mm tt")
                        </dd>

                        <dt class="col-md-4">
                            Mode
                        </dt>

                        <dd class="col-md-8">
                            @Model.Interview.InterviewMode
                        </dd>

                        @if (Model.Interview.InterviewMode == "Online")
                        {
                            <dt class="col-md-4">
                                Meeting Link
                            </dt>

                            <dd class="col-md-8">

                                <a href="@Model.Interview.MeetingLink"
                                   target="_blank"
                                   class="btn btn-sm btn-primary">
                                    Join Interview
                                </a>

                            </dd>
                        }

                        @if (Model.Interview.InterviewMode == "In Person")
                        {
                            <dt class="col-md-4">
                                Location
                            </dt>

                            <dd class="col-md-8">
                                @Model.Interview.Location
                            </dd>
                        }

                        <dt class="col-md-4">
                            Instructions
                        </dt>

                        <dd class="col-md-8">
                            @(Model.Interview.Instructions
                                ?? "No additional instructions.")
                        </dd>

                    </dl>

                    <hr />

                    <a asp-action="MyApplications"
                       class="btn btn-secondary">
                        Back to My Applications
                    </a>

                </div>
            </div>

        </div>
    </div>

</div>