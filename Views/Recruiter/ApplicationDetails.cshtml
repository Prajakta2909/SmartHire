@model SmartHire.Models.JobApplication

@{
    ViewData["Title"] = "Application Details";

    var match =
        ViewBag.JobMatch as SmartHire.ViewModels.JobMatchViewModel;
}

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start">

                <div>
                    <h2>
                        @Model.CandidateProfile.ApplicationUser.FirstName
                        @Model.CandidateProfile.ApplicationUser.LastName
                    </h2>

                    <p class="text-muted">
                        Applied for:
                        <strong>@Model.Job.Title</strong>
                    </p>
                </div>

                <span class="badge bg-primary">
                    @Model.Status
                </span>

            </div>

            <hr />


            @* =========================
               CANDIDATE INFORMATION
               ========================= *@

            <h4>Candidate Information</h4>

            <dl class="row mt-3">

                <dt class="col-md-3">Email</dt>
                <dd class="col-md-9">
                    @Model.CandidateProfile.ApplicationUser.Email
                </dd>

                <dt class="col-md-3">Phone</dt>
                <dd class="col-md-9">
                    @Model.CandidateProfile.PhoneNumber
                </dd>

                <dt class="col-md-3">Location</dt>
                <dd class="col-md-9">
                    @Model.CandidateProfile.Location
                </dd>

                <dt class="col-md-3">Qualification</dt>
                <dd class="col-md-9">
                    @(Model.CandidateProfile.HighestQualification
                        ?? "Not specified")
                </dd>

                <dt class="col-md-3">Specialization</dt>
                <dd class="col-md-9">
                    @(Model.CandidateProfile.Specialization
                        ?? "Not specified")
                </dd>

                <dt class="col-md-3">Graduation Year</dt>
                <dd class="col-md-9">
                    @(Model.CandidateProfile.GraduationYear?.ToString()
                        ?? "Not specified")
                </dd>

                <dt class="col-md-3">Experience</dt>
                <dd class="col-md-9">
                    @Model.CandidateProfile.ExperienceYears year(s)
                </dd>

                <dt class="col-md-3">Current Job Title</dt>
                <dd class="col-md-9">
                    @(Model.CandidateProfile.CurrentJobTitle
                        ?? "Fresher")
                </dd>

                <dt class="col-md-3">Skills</dt>
                <dd class="col-md-9">
                    @(Model.CandidateProfile.Skills
                        ?? "Not specified")
                </dd>

                <dt class="col-md-3">Applied Date</dt>
                <dd class="col-md-9">
                    @Model.AppliedDate.ToString("dd MMM yyyy")
                </dd>

            </dl>

            <hr />


            @* =========================
               CANDIDATE JOB MATCH
               ========================= *@

            @if (match != null)
            {
                <div class="card bg-light mb-4">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <h4 class="mb-0">
                                Candidate Job Match
                            </h4>

                            @if (match.MatchPercentage >= 80)
                            {
                                <span class="badge bg-success">
                                    High Match
                                </span>
                            }
                            else if (match.MatchPercentage >= 50)
                            {
                                <span class="badge bg-warning text-dark">
                                    Medium Match
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Low Match
                                </span>
                            }

                        </div>

                        <hr />

                        <div class="mb-3">

                            <div class="d-flex justify-content-between">

                                <strong>
                                    Overall Match
                                </strong>

                                <strong>
                                    @match.MatchPercentage%
                                </strong>

                            </div>

                            <div class="progress mt-2"
                                 style="height: 25px;">

                                <div class="progress-bar"
                                     role="progressbar"
                                     style="width: @match.MatchPercentage%;"
                                     aria-valuenow="@match.MatchPercentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100">

                                    @match.MatchPercentage%

                                </div>

                            </div>

                        </div>


                        <div class="row mt-4">

                            <div class="col-md-6 mb-3">

                                <div class="border rounded p-3">

                                    <strong>
                                        Skills Match
                                    </strong>

                                    <h4 class="mt-2 mb-0">
                                        @match.SkillMatchPercentage%
                                    </h4>

                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <div class="border rounded p-3">

                                    <strong>
                                        Experience Match
                                    </strong>

                                    <h4 class="mt-2 mb-0">
                                        @match.ExperienceMatchPercentage%
                                    </h4>

                                </div>

                            </div>

                        </div>


                        @if (match.MatchedSkills.Any())
                        {
                            <div class="mt-2">

                                <strong>
                                    Matched Skills:
                                </strong>

                                <div class="mt-2">

                                    @foreach (var skill in match.MatchedSkills)
                                    {
                                        <span class="badge bg-success me-1 mb-1">
                                            @skill
                                        </span>
                                    }

                                </div>

                            </div>
                        }


                        @if (match.MissingSkills.Any())
                        {
                            <div class="mt-3">

                                <strong>
                                    Missing Skills:
                                </strong>

                                <div class="mt-2">

                                    @foreach (var skill in match.MissingSkills)
                                    {
                                        <span class="badge bg-secondary me-1 mb-1">
                                            @skill
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }


            @* =========================
               PROFESSIONAL LINKS
               ========================= *@

            <h4>Professional Links</h4>

            @if (!string.IsNullOrEmpty(
                Model.CandidateProfile.LinkedInUrl))
            {
                <a href="@Model.CandidateProfile.LinkedInUrl"
                   target="_blank"
                   class="btn btn-outline-primary me-2">
                    LinkedIn
                </a>
            }

            @if (!string.IsNullOrEmpty(
                Model.CandidateProfile.GitHubUrl))
            {
                <a href="@Model.CandidateProfile.GitHubUrl"
                   target="_blank"
                   class="btn btn-outline-dark me-2">
                    GitHub
                </a>
            }

            <hr />


            @* =========================
               RESUME
               ========================= *@

            <h4>Resume</h4>

            @if (!string.IsNullOrEmpty(
                Model.CandidateProfile.ResumePath))
            {
                <a asp-action="ViewCandidateResume"
                   asp-route-id="@Model.Id"
                   target="_blank"
                   class="btn btn-success">
                    View Resume
                </a>
            }
            else
            {
                <p class="text-muted">
                    Resume not available.
                </p>
            }

            <hr />


            @* =========================
               TEMP MESSAGES
               ========================= *@

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }


            @* =========================
               APPLICATION DECISION
               ========================= *@

            <h4>Application Decision</h4>

            <p>
                Current Status:
                <strong>@Model.Status</strong>
            </p>


            @* STATUS = APPLIED *@

            @if (Model.Status == "Applied")
            {
                <form asp-action="UpdateApplicationStatus"
                      method="post"
                      class="d-inline">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="status"
                           value="Shortlisted" />

                    <button type="submit"
                            class="btn btn-success">
                        Shortlist
                    </button>

                </form>


                <form asp-action="UpdateApplicationStatus"
                      method="post"
                      class="d-inline">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="status"
                           value="Rejected" />

                    <button type="submit"
                            class="btn btn-danger">
                        Reject
                    </button>

                </form>
            }


            @* STATUS = SHORTLISTED *@

            @if (Model.Status == "Shortlisted")
            {
                <a asp-action="ScheduleInterview"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Schedule Interview
                </a>
            }


            @* STATUS = INTERVIEW SCHEDULED *@

            @if (Model.Status == "Interview Scheduled")
            {
                <h4 class="mt-4">
                    Final Decision
                </h4>

                <form asp-action="UpdateApplicationStatus"
                      method="post"
                      class="d-inline">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="status"
                           value="Selected" />

                    <button type="submit"
                            class="btn btn-success">
                        Select Candidate
                    </button>

                </form>


                <form asp-action="UpdateApplicationStatus"
                      method="post"
                      class="d-inline">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="status"
                           value="Rejected" />

                    <button type="submit"
                            class="btn btn-danger">
                        Reject Candidate
                    </button>

                </form>
            }


            @* STATUS = SELECTED *@

            @if (Model.Status == "Selected")
            {
                <div class="alert alert-success mt-3">
                    Candidate has been selected.
                </div>
            }


            @* STATUS = REJECTED *@

            @if (Model.Status == "Rejected")
            {
                <div class="alert alert-danger mt-3">
                    Candidate has been rejected.
                </div>
            }


            @* =========================
               CHAT + BACK
               ========================= *@

            <div class="mt-4">

                <a asp-controller="Chat"
                   asp-action="Conversation"
                   asp-route-applicationId="@Model.Id"
                   class="btn btn-success me-2">
                    Chat with Candidate
                </a>

                <a asp-action="JobApplications"
                   asp-route-id="@Model.JobId"
                   class="btn btn-secondary">
                    Back to Applications
                </a>

            </div>

        </div>
    </div>

</div>