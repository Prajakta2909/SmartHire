@model SmartHire.ViewModels.CreateJobViewModel

@{
    ViewData["Title"] = "Post Job";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="mb-4">Post a New Job</h2>

                    <form asp-action="CreateJob" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Job Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. Junior .NET Developer" />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe the role and responsibilities">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label asp-for="Location"
                                   class="form-label"></label>

                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="e.g. Pune" />

                            <span asp-validation-for="Location"
                                  class="text-danger"></span>
                        </div>

                        <!-- Employment Type -->
                        <div class="mb-3">
                            <label asp-for="EmploymentType"
                                   class="form-label"></label>

                            <select asp-for="EmploymentType"
                                    class="form-select">

                                <option value="">-- Select Employment Type --</option>
                                <option value="Full Time">Full Time</option>
                                <option value="Part Time">Part Time</option>
                                <option value="Contract">Contract</option>
                                <option value="Internship">Internship</option>

                            </select>

                            <span asp-validation-for="EmploymentType"
                                  class="text-danger"></span>
                        </div>

                        <!-- Skills -->
                        <div class="mb-3">
                            <label asp-for="RequiredSkills"
                                   class="form-label"></label>

                            <input asp-for="RequiredSkills"
                                   class="form-control"
                                   placeholder="e.g. C#, ASP.NET Core, SQL Server, EF Core" />

                            <span asp-validation-for="RequiredSkills"
                                  class="text-danger"></span>
                        </div>

                        <!-- Experience -->
                        <div class="mb-3">
                            <label asp-for="ExperienceRequired"
                                   class="form-label"></label>

                            <input asp-for="ExperienceRequired"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                            <span asp-validation-for="ExperienceRequired"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">

                            <!-- Minimum Salary -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="SalaryMin"
                                       class="form-label"></label>

                                <input asp-for="SalaryMin"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0" />

                                <span asp-validation-for="SalaryMin"
                                      class="text-danger"></span>
                            </div>

                            <!-- Maximum Salary -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="SalaryMax"
                                       class="form-label"></label>

                                <input asp-for="SalaryMax"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0" />

                                <span asp-validation-for="SalaryMax"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Application Deadline -->
                        <div class="mb-3">
                            <label asp-for="ApplicationDeadline"
                                   class="form-label"></label>

                            <input asp-for="ApplicationDeadline"
                                   class="form-control"
                                   type="date" />

                            <span asp-validation-for="ApplicationDeadline"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Post Job
                        </button>

                        <a asp-controller="Recruiter"
                           asp-action="Dashboard"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}