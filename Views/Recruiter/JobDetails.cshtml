@model SmartHire.Models.Job

@{
    ViewData["Title"] = "Job Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <h2>@Model.Title</h2>

                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Closed
                    </span>
                }

            </div>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3">Employment Type</dt>
                <dd class="col-sm-9">@Model.EmploymentType</dd>

                <dt class="col-sm-3">Experience Required</dt>
                <dd class="col-sm-9">
                    @Model.ExperienceRequired year(s)
                </dd>

                <dt class="col-sm-3">Required Skills</dt>
                <dd class="col-sm-9">
                    @(Model.RequiredSkills ?? "Not specified")
                </dd>

                <dt class="col-sm-3">Salary</dt>
                <dd class="col-sm-9">

                    @if (Model.SalaryMin.HasValue ||
                         Model.SalaryMax.HasValue)
                    {
                        <span>
                            @(Model.SalaryMin?.ToString("N2") ?? "Not specified")
                            -
                            @(Model.SalaryMax?.ToString("N2") ?? "Not specified")
                        </span>
                    }
                    else
                    {
                        <span>Not specified</span>
                    }

                </dd>

                <dt class="col-sm-3">Posted Date</dt>
                <dd class="col-sm-9">
                    @Model.PostedDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Application Deadline</dt>
                <dd class="col-sm-9">

                    @(Model.ApplicationDeadline.HasValue
                        ? Model.ApplicationDeadline.Value.ToString("dd MMM yyyy")
                        : "Not specified")

                </dd>

            </dl>

            <hr />

            <h5>Job Description</h5>

            <p style="white-space: pre-line;">
                @Model.Description
            </p>

            <hr />

            <a asp-action="EditJob"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit Job
            </a>

            <a asp-action="MyJobs"
               class="btn btn-secondary">
                Back to My Jobs
            </a>

        </div>

    </div>

</div>