@model IEnumerable<SmartHire.Models.Job>

@{
    ViewData["Title"] = "My Jobs";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Jobs</h2>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <a asp-action="CreateJob"
           class="btn btn-primary">
            Post New Job
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't posted any jobs yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Experience</th>
                        <th>Posted</th>
                        <th>Deadline</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var job in Model)
                    {
                        <tr>

                            <td>@job.Title</td>

                            <td>@job.Location</td>

                            <td>@job.EmploymentType</td>

                            <td>@job.ExperienceRequired year(s)</td>

                            <td>
                                @job.PostedDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @(job.ApplicationDeadline.HasValue
                                    ? job.ApplicationDeadline.Value.ToString("dd MMM yyyy")
                                    : "Not specified")
                            </td>

                            <td>
                                @if (job.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Closed
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-action="JobDetails"
                                   asp-route-id="@job.Id"
                                   class="btn btn-sm btn-info">
                                    View
                                </a>

                                <a asp-action="EditJob"
                                   asp-route-id="@job.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="JobApplications"
                                   asp-route-id="@job.Id"
                                   class="btn btn-sm btn-primary">
                                    Applications
                                </a>

                                <form asp-action="ToggleJobStatus"
                                      asp-route-id="@job.Id"
                                      method="post"
                                      class="d-inline">

                                    @if (job.IsActive)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Close
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Reopen
                                        </button>
                                    }

                                </form>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>