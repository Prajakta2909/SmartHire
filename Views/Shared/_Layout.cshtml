<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartHire</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartHire.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- SmartHire Logo / Name -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    SmartHire
                </a>

                <!-- Mobile Navbar Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- LEFT SIDE NAVIGATION -->

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->
                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>

                        </li>


                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {

                            <!-- ========================= -->
                            <!-- CANDIDATE NAVIGATION -->
                            <!-- ========================= -->
                            @if (User.IsInRole("Candidate"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Candidate"
                                       asp-action="Dashboard">
                                        Dashboard
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Candidate"
                                       asp-action="BrowseJobs">
                                        Browse Jobs
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Candidate"
                                       asp-action="MyApplications">
                                        My Applications
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Candidate"
                                       asp-action="Profile">
                                        Profile
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Candidate"
                                       asp-action="UploadResume">
                                        Resume
                                    </a>

                                </li>


                                <!-- Notifications -->
                                <li class="nav-item">

                                    @await Component.InvokeAsync("NotificationCount")

                                </li>


                                <!-- Messages -->
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Chat"
                                       asp-action="Inbox">

                                        Messages

                                        <span id="messageCount"
                                              class="badge bg-danger"
                                              style="display:none;">
                                        </span>

                                    </a>

                                </li>
                            }


                            <!-- ========================= -->
                            <!-- RECRUITER NAVIGATION -->
                            <!-- ========================= -->
                            @if (User.IsInRole("Recruiter"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Recruiter"
                                       asp-action="Dashboard">
                                        Dashboard
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Recruiter"
                                       asp-action="CreateJob">
                                        Post Job
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Recruiter"
                                       asp-action="MyJobs">
                                        My Jobs
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Recruiter"
                                       asp-action="Interviews">
                                        Interviews
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Recruiter"
                                       asp-action="Profile">
                                        Company Profile
                                    </a>

                                </li>


                                <!-- Notifications -->
                                <li class="nav-item">

                                    @await Component.InvokeAsync("NotificationCount")

                                </li>


                                <!-- Messages -->
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Chat"
                                       asp-action="Inbox">

                                        Messages

                                        <span id="messageCount"
                                              class="badge bg-danger"
                                              style="display:none;">
                                        </span>

                                    </a>

                                </li>
                            }


                            <!-- ========================= -->
                            <!-- ADMIN NAVIGATION -->
                            <!-- ========================= -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Dashboard">
                                        Admin Dashboard
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Users">
                                        Manage Users
                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Jobs">
                                        Manage Jobs
                                    </a>

                                </li>
                            }
                        }

                    </ul>


                    <!-- ========================= -->
                    <!-- RIGHT SIDE NAVIGATION -->
                    <!-- ========================= -->

                    <ul class="navbar-nav">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            <!-- Logged-in User -->

                            <li class="nav-item">

                                <span class="nav-link text-dark">
                                    Hello, @User.Identity.Name
                                </span>

                            </li>


                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="nav-link btn btn-link text-dark">
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- User is NOT logged in -->

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ========================= -->
    <!-- PAGE CONTENT -->
    <!-- ========================= -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- ========================= -->
    <!-- FOOTER -->
    <!-- ========================= -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - SmartHire -

            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>


    <!-- ========================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- ========================= -->
    <!-- UNREAD MESSAGE COUNT -->
    <!-- ========================= -->
    @if (User.Identity != null &&
             User.Identity.IsAuthenticated &&
             (User.IsInRole("Candidate") ||
              User.IsInRole("Recruiter")))
    {
        <script>

            async function loadUnreadMessageCount() {

            try {

            const response =
            await fetch('/Chat/UnreadCount');

            if (!response.ok) {
            return;
            }

            const count =
            await response.json();

            const badge =
            document.getElementById('messageCount');

            if (!badge) {
            return;
            }

            if (count > 0) {

            badge.textContent = count;

            badge.style.display =
            'inline-block';
            }
            else {

            badge.textContent = '';

            badge.style.display =
            'none';
            }
            }
            catch (error) {

            console.error(
            'Unable to load unread message count.',
            error);
            }
            }


            loadUnreadMessageCount();

        </script>
    }


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>